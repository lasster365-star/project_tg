# Токен Telegram-бота от @BotFather
BOT_TOKEN=

# URL мини-апп. Для прод (Railway) это HTTPS, Telegram требует https://.
# ВАЖНО: для локальной отладки используйте http://localhost:8080 или ngrok.
TWA_URL=https://feisty-cooperation-production-4c04.up.railway.app

# Хост/порт FastAPI. Railway инжектит PORT автоматически — оставьте так.
API_HOST=0.0.0.0
PORT=8080

# Postgres на Railway: DATABASE_URL=postgresql://user:pass@host:port/railway
# Локально по умолчанию SQLite.
DATABASE_URL=sqlite+aiosqlite:///./shop.db

# Сколько начислим рефереру при первой оплате приглашённого (в рублях).
REFERRAL_BONUS=100

# TTL initData, секунд
INITDATA_TTL=3600

# Поддержка — имя пользователя/чата (без @ или с @)
SUPPORT_CHAT=lasster_support

# Токен админки. Сгенерируйте у себя (например: python -c "import secrets; print(secrets.token_urlsafe(24))")
ADMIN_TOKEN=

# Telegram ID админов (через запятую). Этим людям бот покажет админ-меню.
ADMIN_IDS=

DEBUG=0
